# Flower does not generate its own CA, it must trust the same CA that signed
# RabbitMQ's server certificate for the amqps:// connection to succeed.
# Copy the real ca_certificate.pem generated in
# distribute/brokers/rabbitmq/certificates/ into this directory, then rename
# it (drop the "template." prefix) so it lands at ./ca_certificate.pem.
cp ../../../distribute/brokers/rabbitmq/certificates/ca_certificate.pem ./ca_certificate.pem
