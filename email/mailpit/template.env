# For all strings containing special characters, use single quotes.
# In case of older docker compose versions (<3.9), do not use single or double quotes at all.

# Container's docker environment configuration.
COMPOSE_PROJECT_NAME="lowercase_string_without_special_characters"

# Mailpit's docker environment configuration.
MAILPIT_SMTP_PORT=1234
MAILPIT_PORT=5678
# Setting this to true allows any SMTP username/password to relay mail, effectively disabling authentication.
# Keep false outside a fully isolated single-user development environment.
MAILPIT_SMTP_AUTH_ACCEPT_ANY=false
# Setting this to true accepts SMTP authentication over plain, unencrypted connections.
# Keep false outside a fully isolated single-user development environment.
MAILPIT_SMTP_AUTH_ALLOW_INSECURE=false
# Web UI basic authentication, format 'username:password'. Captured emails may contain sensitive
# data such as password-reset links, so this must always be set to a non-default credential.
MAILPIT_UI_AUTH='string_with_special_characters'
